# Database Configuration
# ----------------------
# For Turso Cloud (libSQL):
# DATABASE_URL="libsql://your-database-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# For Local Development / Self-Hosted (SQLite):
DATABASE_URL="file:./local.db"

# Application Settings
NEXT_PUBLIC_APP_NAME="JlightCalendar"
NEXT_PUBLIC_DEFAULT_PIN="1234"

# Google OAuth 2.0 (Epic 1 & Epic 2)
# ----------------------------------
# Required for user authentication and multi-galaxy management:
AUTH_SECRET="your-32-byte-base64-or-hex-secret-generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Immich / Photos (Phase 5)
# IMMICH_API_URL=""
# IMMICH_API_KEY=""
